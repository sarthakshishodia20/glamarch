# ─────────────────────────────────────────────
#  GLAM Backend — Environment Variables Template
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Server port
PORT=5000

# ── MySQL Database Config ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=glam_onboarding
# Local dev ke liye socket path (Ubuntu mein MySQL socket se connect hota hai)
DB_SOCKET=/var/run/mysqld/mysqld.sock

# ── JWT Secret ──
JWT_SECRET=glam_super_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# ── File Upload ──
MAX_FILE_SIZE=5242880

# ── Cloudinary Config (Document Cloud Storage) ──
# Cloudinary.com par free account banao, Dashboard > API Keys se copy karo
# Agar ye teen variables SET hain → files Cloudinary pr jaengi (PRODUCTION)
# Agar SET NAHI hain → files local disk pr save hongi (DEVELOPMENT - default)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── App Mode ──
NODE_ENV=development
